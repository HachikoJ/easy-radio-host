[Unit]
Description=Tingjian AI radio
After=network-online.target tingjian-musiclib.service tingjian-tts.service
Wants=network-online.target tingjian-musiclib.service tingjian-tts.service

[Service]
Type=simple
User=tingjian
Group=tingjian
WorkingDirectory=/opt/easy-radio-host/backend
EnvironmentFile=/etc/tingjian/radio.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=-/bin/sh -c 'if [ -z "${LOCAL_TTS_URL:-}" ]; then exit 0; fi; i=0; while [ "$i" -lt 10 ]; do curl -fsS --max-time 1 "${LOCAL_TTS_URL}/health" >/dev/null && exit 0; i=$((i + 1)); sleep 1; done; exit 1'
ExecStart=/opt/easy-radio-host/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=tingjian
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
